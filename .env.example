# Copy to .env.local and fill in your keys. Restart `npm run dev` afterwards.
# These are server-side only - Vite does not inline them into the bundle.

# Gemini keys, tried in order: 1, 2, 3 ...
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# OpenRouter keys, tried after the Gemini keys are exhausted.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# Optional model overrides (light = fast/cheap, strong = better answers)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_STRONG=gemini-3.6-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: try OpenRouter's strong model first for hard prompts
# AI_PREFER_STRONG=openrouter

# Optional: port for `npm start` (default 3000)
# PORT=3000

# Optional: abuse protection for /api/chat (per IP)
# CHAT_RATE_PER_MIN=20
# CHAT_RATE_PER_DAY=200
# TRUST_PROXY=1   # only behind your own reverse proxy
